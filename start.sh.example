#!/bin/bash
# Example production/local launcher.
# Copy this file to start.sh, fill real secrets in your environment or in the
# copied file, then run: bash start.sh

set -e

export FLASK_HOST="${FLASK_HOST:-0.0.0.0}"
export FLASK_PORT="${FLASK_PORT:-5001}"
export FLASK_DEBUG="${FLASK_DEBUG:-0}"

export DEEPSEEK_TOKEN="${DEEPSEEK_TOKEN:-}"
export OPENCLAW_TOKEN="${OPENCLAW_TOKEN:-}"
export OPENCLAW_WS_URL="${OPENCLAW_WS_URL:-ws://127.0.0.1:18789}"
export OPENCLAW_AGENT_ID="${OPENCLAW_AGENT_ID:-main}"

python3 app.py
